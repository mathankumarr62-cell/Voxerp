VOXERP_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True only behind a trusted proxy that strips and overwrites X-Forwarded-Proto.
VOXERP_TRUSTED_PROXY_SSL_HEADER=False
# Production requires a positive value; enable only after HTTPS is operational.
VOXERP_SECURE_HSTS_SECONDS=0
VOXERP_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
VOXERP_SECURE_HSTS_PRELOAD=False
# Optional separate Django auth/session database; never the ERP database.

# VOXERP_APP_DB=/absolute/private/path/auth.sqlite3
VOXERP_USE_REAL_DB=False
VOXERP_ALLOW_REAL_WRITES=False
VOXERP_OFFLINE_MODE=False
DB_HOST=your-private-mariadb-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=ramco_academic_system
VOXERP_GEMMA_MODEL=mlx-community/gemma-4-e4b-it-4bit
VOXERP_GEMMA_MAX_TOKENS=80
VOXERP_GEMMA_TEMPERATURE=0.0
VOXERP_GEMMA_REPETITION_PENALTY=1.05
