# VoxERP MariaDB Configuration
# Copy this to .env and fill in your values
# This file is for local development only. Production values belong in the
# college-managed secret store or a host-restricted environment file.

VOXERP_ENV=development
VOXERP_AUTH_MODE=demo
# Explicit opt-in for local SQLite startup only; importing Flask never initializes data.
VOXERP_INITIALIZE_DATABASE=False

# SQLite ignores DB_* values. For real READ validation use the approved
# Windows ERP host on Tailscale/private networking; never expose public 3306.
DB_HOST=localhost
DB_PORT=3306
# Replace with an existing provisioned read-only account for real ERP access.
DB_USER=root
DB_PASSWORD=
DB_NAME=ramco_academic_system

# False selects the local SQLite fixture. True is for reviewed real ERP READ
# validation only; existing MariaDB test suites include write expectations.
VOXERP_USE_REAL_DB=False

# Keep False. Real ERP writes are not approved. Even an isolated clone needs
# explicit owner approval before any future write validation.
# Production proxy/identity settings are documented in DEPLOYMENT.md.
VOXERP_ALLOW_REAL_WRITES=False

# Optional deterministic SQLite demo mode; keep False for actual model inference.
VOXERP_OFFLINE_MODE=False
# Required for proxy-mode confirmations; supply privately, never commit a real key.
VOXERP_PENDING_SECRET=
